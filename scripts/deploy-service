#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly EXPECTED_REPOSITORY="zainfathoni/cukup"
readonly EXPECTED_ORIGIN="https://github.com/zainfathoni/cukup"
readonly EXPECTED_SERVICE="cukup-service"
readonly EXPECTED_SOURCE="$EXPECTED_ORIGIN"
readonly EXPECTED_API_HOSTNAME="api.cukup.dev"
readonly EXPECTED_DASHBOARD_HOSTNAME="cukup.dev"

mode="${1:-}"
if [[ "$mode" != "preflight" && "$mode" != "deploy" ]]; then
	printf 'usage: %s preflight|deploy\n' "$0" >&2
	exit 2
fi

required_environment=(
	CUKUP_REVISION
	CUKUP_RELEASE_ROOT
	CUKUP_IMAGE
	CUKUP_DEPLOY_HOST
	CUKUP_SSH_USER
	CUKUP_SSH_KEY
	CUKUP_API_HOSTNAME
	CUKUP_DASHBOARD_HOSTNAME
	CUKUP_DATA_DIRECTORY
	CUKUP_BACKUP_DIRECTORY
	KAMAL_REGISTRY_USERNAME
	GITHUB_TOKEN
)
for name in "${required_environment[@]}"; do
	[[ -n "${!name:-}" ]] || {
		printf 'required environment is missing: %s\n' "$name" >&2
		exit 1
	}
done

readonly candidate="$CUKUP_REVISION"
readonly release_root="$CUKUP_RELEASE_ROOT"
readonly expected_image="ghcr.io/$CUKUP_IMAGE"
readonly remote_target="$CUKUP_SSH_USER@$CUKUP_DEPLOY_HOST"

[[ "$candidate" =~ ^[0-9a-f]{40}$ ]] || {
	printf 'revision must be a full lowercase commit SHA\n' >&2
	exit 1
}
[[ -d "$release_root/.git" ]] || {
	printf 'release checkout is unavailable\n' >&2
	exit 1
}
[[ "$CUKUP_IMAGE" == "zainfathoni/cukup" ]] || {
	printf 'unexpected image\n' >&2
	exit 1
}
[[ "$KAMAL_REGISTRY_USERNAME" == "zainfathoni" ]] || {
	printf 'unexpected registry identity\n' >&2
	exit 1
}
[[ "$CUKUP_API_HOSTNAME" == "$EXPECTED_API_HOSTNAME" ]] || {
	printf 'unexpected API hostname\n' >&2
	exit 1
}
[[ "$CUKUP_DASHBOARD_HOSTNAME" == "$EXPECTED_DASHBOARD_HOSTNAME" ]] || {
	printf 'unexpected dashboard hostname\n' >&2
	exit 1
}
[[ "$CUKUP_DATA_DIRECTORY" =~ ^/[A-Za-z0-9._/-]+$ ]] || {
	printf 'invalid data directory\n' >&2
	exit 1
}
[[ "$CUKUP_BACKUP_DIRECTORY" =~ ^/[A-Za-z0-9._/-]+$ ]] || {
	printf 'invalid backup directory\n' >&2
	exit 1
}
[[ -f "$CUKUP_SSH_KEY" ]] || {
	printf 'SSH key is unavailable\n' >&2
	exit 1
}
[[ "$(stat -c %a "$CUKUP_SSH_KEY")" == 600 ]] || {
	printf 'SSH key must have mode 0600\n' >&2
	exit 1
}

temp_dir="$(mktemp -d)"
chmod 0700 "$temp_dir"
rendered_config="$temp_dir/deploy.service.yml"
auth_config="$temp_dir/curl-auth.conf"
phase="startup"
prior_version=""
prior_container=""
prior_image=""
prior_runtime_hash=""
backup_base=""
mutation_started=0

cleanup() {
	rm -rf "$temp_dir"
}

summary() {
	local outcome="$1"
	if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
		# shellcheck disable=SC2016 # Markdown backticks are literal.
		printf -- '- `%s` `%s` for `%s` at phase `%s`.\n' "$mode" "$outcome" "$candidate" "$phase" \
			>> "$GITHUB_STEP_SUMMARY"
	fi
}

remote() {
	ssh \
		-i "$CUKUP_SSH_KEY" \
		-o IdentitiesOnly=yes \
		-o BatchMode=yes \
		-o ForwardAgent=no \
		-o StrictHostKeyChecking=yes \
		-o ConnectTimeout=15 \
		"$remote_target" "$@"
}

run_kamal() {
	local version="$1"
	shift
	(
		cd "$release_root"
		VERSION="$version" kamal "$@" -c "$rendered_config"
	)
}

running_info() {
	# shellcheck disable=SC2016 # This script is evaluated by the remote shell.
	remote 'set -eu
ids=$(docker ps -q --filter label=service=cukup-service)
test "$(printf "%s\n" "$ids" | sed "/^$/d" | wc -l | tr -d " ")" = 1
id=$ids
docker inspect "$id" | jq -r ".[0] | [.Id, .Name, .Config.Image] | @tsv"'
}

running_version() {
	local info id name version
	info="$(running_info 2>/dev/null)" || return 1
	IFS=$'\t' read -r id name _ <<< "$info"
	name="${name#/}"
	version="${name#cukup-service-web-}"
	[[ "$name" == "cukup-service-web-$version" && "$version" =~ ^[0-9a-f]{40}$ ]] || return 1
	printf '%s\n' "$version"
}

runtime_hash() {
	local container="$1"
	[[ "$container" =~ ^[0-9a-f]{64}$ ]] || return 1
	remote "set -o pipefail; docker inspect '$container' | jq -S -c '.[0] | {
Env:(.Config.Env | map(select(((startswith(\"KAMAL_CONTAINER_NAME=\") or startswith(\"KAMAL_VERSION=\")) | not))) | sort),
ReadonlyRootfs:.HostConfig.ReadonlyRootfs,
NanoCpus:.HostConfig.NanoCpus,
Memory:.HostConfig.Memory,
MemorySwap:.HostConfig.MemorySwap,
PidsLimit:.HostConfig.PidsLimit,
Binds:(.HostConfig.Binds | sort)
}' | sha256sum | cut -d' ' -f1"
}

verify_database() {
	local output
	output="$(remote "sudo -n sqlite3 -readonly '$CUKUP_DATA_DIRECTORY/cukup.sqlite' 'PRAGMA user_version; PRAGMA integrity_check;'" 2>/dev/null)" || return 1
	[[ "$output" == $'4\nok' ]]
}

verify_preservation() {
	local output
	[[ "$backup_base" =~ ^[0-9A-Za-z-]+$ ]] || return 1
	output="$(remote "sudo -n sqlite3 -readonly '$CUKUP_DATA_DIRECTORY/cukup.sqlite' \"ATTACH DATABASE '$CUKUP_BACKUP_DIRECTORY/$backup_base.sqlite' AS pre;
PRAGMA main.user_version;
PRAGMA main.integrity_check;
SELECT EXISTS(SELECT * FROM pre.auth_tokens EXCEPT SELECT * FROM main.auth_tokens);
SELECT EXISTS(SELECT * FROM pre.source_owners EXCEPT SELECT * FROM main.source_owners);
SELECT EXISTS(SELECT * FROM pre.events EXCEPT SELECT * FROM main.events);
SELECT EXISTS(SELECT * FROM pre.target_overrides EXCEPT SELECT * FROM main.target_overrides);\"" 2>/dev/null)" || return 1
	[[ "$output" == $'4\nok\n0\n0\n0\n0' ]]
}

verify_public_once() {
	local body headers code location
	body="$temp_dir/public-body"
	headers="$temp_dir/public-headers"

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--output "$body" --write-out '%{http_code}' "https://$CUKUP_API_HOSTNAME/healthz")" || return 1
	[[ "$code" == 200 ]] || return 1
	jq -e '. == {"ok":true}' "$body" >/dev/null 2>&1 || return 1

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--output "$body" --write-out '%{http_code}' "https://$CUKUP_DASHBOARD_HOSTNAME/up")" || return 1
	[[ "$code" == 200 ]] || return 1
	jq -e '. == {"ok":true}' "$body" >/dev/null 2>&1 || return 1

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--output "$body" --write-out '%{http_code}' "https://$CUKUP_DASHBOARD_HOSTNAME/")" || return 1
	[[ "$code" == 200 ]] || return 1
	grep -Fq '<title>Sign in · Cukup</title>' "$body" || return 1

	for asset in dashboard.css dashboard.js favicon.svg; do
		code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
			--output "$body" --write-out '%{http_code}' \
			"https://$CUKUP_DASHBOARD_HOSTNAME/assets/$asset")" || return 1
		[[ "$code" == 200 && -s "$body" ]] || return 1
	done

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--dump-header "$headers" --output "$body" --write-out '%{http_code}' \
		"https://$CUKUP_DASHBOARD_HOSTNAME/auth/github")" || return 1
	[[ "$code" == 303 ]] || return 1
	location="$(sed -n 's/^[Ll]ocation:[[:space:]]*//p' "$headers" | tr -d '\r' | tail -n1)"
	[[ "$location" == https://github.com/login/oauth/authorize\?* ]] || return 1
	grep -Eiq '^set-cookie:[[:space:]]*__Host-cukup_oauth=' "$headers" || return 1
}

verify_authenticated_api_once() {
	local body code endpoint
	[[ -n "${CUKUP_API_TOKEN:-}" ]] || return 0
	body="$temp_dir/api-response.json"
	for endpoint in capabilities time summary; do
		code="$(curl --config "$auth_config" --silent --show-error --connect-timeout 10 --max-time 20 \
			--output "$body" --write-out '%{http_code}' \
			"https://$CUKUP_API_HOSTNAME/v1/$endpoint")" || return 1
		[[ "$code" == 200 ]] || return 1
		case "$endpoint" in
			capabilities)
				jq -e '.schema_version == 1 and .accepted_event_schema_versions == [1, 2] and .preferred_new_event_schema_version == 2' "$body" >/dev/null
				;;
			time)
				jq -e '.server_time | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T")' "$body" >/dev/null
				;;
			summary)
				jq -e 'type == "object" and .schema_version == 1 and (.daily | type == "object") and (.weekly | type == "object")' "$body" >/dev/null
				;;
		esac
	done
}

verify_service() {
	local _
	for _ in {1..12}; do
		if verify_public_once && verify_authenticated_api_once; then
			return 0
		fi
		sleep 5
	done
	return 1
}

verify_remote_image() {
	local image_json
	image_json="$(remote "docker image inspect '$expected_image:$candidate'" 2>/dev/null)" || return 1
	jq -e --arg sha "$candidate" --arg service "$EXPECTED_SERVICE" --arg source "$EXPECTED_SOURCE" '
		length == 1 and
		.[0].Os == "linux" and .[0].Architecture == "amd64" and
		.[0].Config.Labels.service == $service and
		.[0].Config.Labels["org.opencontainers.image.source"] == $source and
		.[0].Config.Labels["org.opencontainers.image.revision"] == $sha
	' <<< "$image_json" >/dev/null
}

verify_source_authorization() {
	local main_tip commit_json runs_json
	main_tip="$(gh api "repos/$EXPECTED_REPOSITORY/git/ref/heads/main" --jq .object.sha)"
	[[ "$main_tip" =~ ^[0-9a-f]{40}$ ]] || return 1
	git -C "$release_root" merge-base --is-ancestor "$candidate" "$main_tip" || return 1

	for revision in "$candidate" "$main_tip"; do
		commit_json="$(gh api "repos/$EXPECTED_REPOSITORY/commits/$revision")" || return 1
		jq -e --arg sha "$revision" '
			.sha == $sha and .commit.verification.verified == true and .commit.verification.reason == "valid"
		' <<< "$commit_json" >/dev/null || return 1
	done

	runs_json="$(gh api -X GET "repos/$EXPECTED_REPOSITORY/actions/workflows/publish-service.yml/runs" \
		-f branch=main -f head_sha="$candidate" -f status=completed -f per_page=100)" || return 1
	jq -e --arg sha "$candidate" '
		any(.workflow_runs[];
			.name == "Publish service image" and
			.path == ".github/workflows/publish-service.yml" and
			.event == "push" and .head_branch == "main" and .head_sha == $sha and
			.status == "completed" and .conclusion == "success")
	' <<< "$runs_json" >/dev/null
}

verify_local_image() {
	local image_json
	docker pull --quiet --platform linux/amd64 "$expected_image:$candidate" >/dev/null
	image_json="$(docker image inspect "$expected_image:$candidate")"
	jq -e --arg sha "$candidate" --arg service "$EXPECTED_SERVICE" --arg source "$EXPECTED_SOURCE" --arg image "$expected_image" '
		length == 1 and .[0].Os == "linux" and .[0].Architecture == "amd64" and
		.[0].Config.Labels.service == $service and
		.[0].Config.Labels["org.opencontainers.image.source"] == $source and
		.[0].Config.Labels["org.opencontainers.image.revision"] == $sha and
		any(.[0].RepoDigests[]; startswith($image + "@sha256:"))
	' <<< "$image_json" >/dev/null
}

render_config() {
	cp "$release_root/config/deploy.service.yml" "$rendered_config"
	cat >> "$rendered_config" <<'YAML'

# GitHub Actions operator controls. Retain existing Cukup containers while the
# canary proves rollback safety, and use only the dedicated deployment key.
retain_containers: 1000
ssh:
  user: <%= ENV.fetch("CUKUP_SSH_USER") %>
  keys_only: true
  keys:
    - <%= ENV.fetch("CUKUP_SSH_KEY") %>
YAML
	chmod 0600 "$rendered_config"
	run_kamal "$candidate" config >/dev/null
}

verify_no_deploy_lock() {
	local output
	output="$(run_kamal "$candidate" lock status 2>&1)" || return 1
	grep -Fq 'There is no deploy lock' <<< "$output"
}

take_predeploy_backup() {
	remote "set -euo pipefail
before=\$(sudo -n find '$CUKUP_BACKUP_DIRECTORY' -maxdepth 1 -type f -name '*.sqlite' -printf '%f\\n' | sort | tail -n1)
sudo -n systemctl start cukup-backup.service
test \"\$(sudo -n systemctl show cukup-backup.service -p Result --value)\" = success
test \"\$(sudo -n systemctl show cukup-backup.service -p ExecMainStatus --value)\" = 0
after=\$(sudo -n find '$CUKUP_BACKUP_DIRECTORY' -maxdepth 1 -type f -name '*.sqlite' -printf '%f\\n' | sort | tail -n1)
test -n \"\$after\"
test \"\$after\" != \"\$before\"
base=\${after%.sqlite}
case \"\$base\" in *[!0-9A-Za-z-]*) exit 1;; esac
sudo -n test -f '$CUKUP_BACKUP_DIRECTORY/'\"\$base.json\"
sudo -n jq -e --arg base \"\$base\" '.integrity_check == \"ok\" and .sqlite_user_version == 4 and .database_file == (\$base + \".sqlite\")' '$CUKUP_BACKUP_DIRECTORY/'\"\$base.json\" >/dev/null
printf '%s\\n' \"\$base\"" 2>/dev/null
}

verify_independent_backup() {
	local sqlite="$temp_dir/$backup_base.sqlite"
	local metadata="$temp_dir/$backup_base.json"
	[[ "$backup_base" =~ ^[0-9A-Za-z-]+$ ]] || return 1
	remote "sudo -n cat '$CUKUP_BACKUP_DIRECTORY/$backup_base.sqlite'" > "$sqlite"
	remote "sudo -n cat '$CUKUP_BACKUP_DIRECTORY/$backup_base.json'" > "$metadata"
	chmod 0600 "$sqlite" "$metadata"
	bun run "$release_root/service/database-ops.ts" verify "$sqlite" "$metadata" \
		> "$temp_dir/backup-verification.json"
	jq -e --arg base "$backup_base" '
		.integrity_check == "ok" and .sqlite_user_version == 4 and .database_file == ($base + ".sqlite")
	' "$temp_dir/backup-verification.json" >/dev/null
}

rollback_if_needed() {
	local current rollback_ok=1 info id name
	[[ -n "$prior_version" ]] || return 1
	current="$(running_version 2>/dev/null || true)"
	if [[ "$current" != "$prior_version" ]]; then
		run_kamal "$prior_version" rollback "$prior_version" >/dev/null 2>&1 || rollback_ok=0
	fi
	[[ "$(running_version 2>/dev/null || true)" == "$prior_version" ]] || rollback_ok=0
	info="$(running_info 2>/dev/null || true)"
	IFS=$'\t' read -r id name _ <<< "$info"
	[[ -n "$id" && "$(runtime_hash "$id" 2>/dev/null || true)" == "$prior_runtime_hash" ]] || rollback_ok=0
	verify_service >/dev/null 2>&1 || rollback_ok=0
	verify_database >/dev/null 2>&1 || rollback_ok=0
	verify_preservation >/dev/null 2>&1 || rollback_ok=0
	(( rollback_ok ))
}

on_error() {
	local status=$?
	trap - ERR
	set +e
	if (( mutation_started )); then
		phase="rollback"
		if rollback_if_needed; then
			summary "failed-and-rolled-back"
		else
			summary "failed-rollback-unverified"
		fi
	else
		summary "failed-before-deploy"
	fi
	exit "$status"
}

trap cleanup EXIT
trap on_error ERR

if [[ -n "${CUKUP_API_TOKEN:-}" ]]; then
	[[ "$CUKUP_API_TOKEN" =~ ^cukup_v1_[A-Za-z0-9_-]{43}$ ]] || {
		printf 'acceptance token has an invalid format\n' >&2
		exit 1
	}
	printf 'header = "Authorization: Bearer %s"\n' "$CUKUP_API_TOKEN" > "$auth_config"
	chmod 0600 "$auth_config"
fi

phase="source-authorization"
verify_source_authorization

phase="image-verification"
verify_local_image

phase="operator-config"
render_config

phase="remote-lock"
verify_no_deploy_lock

phase="current-service"
info="$(running_info)"
IFS=$'\t' read -r prior_container prior_name prior_image <<< "$info"
prior_name="${prior_name#/}"
prior_version="${prior_name#cukup-service-web-}"
[[ "$prior_container" =~ ^[0-9a-f]{64}$ ]]
[[ "$prior_name" == "cukup-service-web-$prior_version" && "$prior_version" =~ ^[0-9a-f]{40}$ ]]
[[ "$prior_image" == "$expected_image:$prior_version" ]]
git -C "$release_root" merge-base --is-ancestor "$prior_version" "$candidate"
git -C "$release_root" show "$prior_version:service/store.ts" | grep -Eq '^const DATABASE_VERSION = 4$'
prior_runtime_hash="$(runtime_hash "$prior_container")"
[[ "$prior_runtime_hash" =~ ^[0-9a-f]{64}$ ]]
verify_database
verify_service

if [[ "$mode" == "preflight" ]]; then
	phase="complete"
	summary "success-no-mutation"
	exit 0
fi

if [[ "$prior_version" == "$candidate" ]]; then
	phase="already-current"
	verify_remote_image
	summary "success-no-mutation"
	exit 0
fi

phase="predeploy-backup"
backup_base="$(take_predeploy_backup)"
verify_independent_backup
verify_preservation

phase="final-authorization"
verify_source_authorization

phase="deploy"
mutation_started=1
run_kamal "$candidate" deploy --skip-push

phase="post-deploy"
[[ "$(running_version)" == "$candidate" ]]
verify_remote_image
post_info="$(running_info)"
IFS=$'\t' read -r post_container post_name post_image <<< "$post_info"
[[ "${post_name#/}" == "cukup-service-web-$candidate" ]]
[[ "$post_image" == "$expected_image:$candidate" ]]
[[ "$(runtime_hash "$post_container")" == "$prior_runtime_hash" ]]
remote "docker container inspect '$prior_container'" >/dev/null
remote "docker image inspect '$prior_image'" >/dev/null
verify_service
verify_database
verify_preservation

mutation_started=0
phase="complete"
summary "success"
