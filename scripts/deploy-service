#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly EXPECTED_SERVICE="cukup-service"

mode="${1:-}"
if [[ "$mode" != "preflight" && "$mode" != "deploy" ]]; then
	printf 'usage: %s preflight|deploy\n' "$0" >&2
	exit 2
fi

required_environment=(
	CUKUP_REVISION
	CUKUP_RELEASE_ROOT
	CUKUP_DEPLOY_HOST
	CUKUP_SSH_USER
	CUKUP_SSH_KEY
	CUKUP_API_HOSTNAME
	CUKUP_DASHBOARD_HOSTNAME
	CUKUP_WORK_PROJECTS
	CUKUP_DATA_DIRECTORY
	CUKUP_BACKUP_DIRECTORY
	GITHUB_REPOSITORY
	GITHUB_TOKEN
	CUKUP_OIDC_ALLOWED_USER_ID
	CUKUP_FLEET_HOSTNAMES
	CUKUP_GITHUB_OAUTH_CLIENT_ID
	CUKUP_GITHUB_OAUTH_CLIENT_SECRET
	CUKUP_GITHUB_ALLOWED_USER_ID
	CUKUP_DASHBOARD_SESSION_KEYS
)
for name in "${required_environment[@]}"; do
	[[ -n "${!name:-}" ]] || {
		printf 'required environment is missing: %s\n' "$name" >&2
		exit 1
	}
done

[[ "$GITHUB_REPOSITORY" =~ ^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$ ]] || {
	printf 'invalid GitHub repository\n' >&2
	exit 1
}
readonly EXPECTED_REPOSITORY="$GITHUB_REPOSITORY"
readonly EXPECTED_SOURCE="https://github.com/$EXPECTED_REPOSITORY"
CUKUP_IMAGE="$(printf '%s' "$EXPECTED_REPOSITORY" | tr '[:upper:]' '[:lower:]')"
KAMAL_REGISTRY_USERNAME="${EXPECTED_REPOSITORY%/*}"
readonly CUKUP_IMAGE KAMAL_REGISTRY_USERNAME
export CUKUP_IMAGE KAMAL_REGISTRY_USERNAME

readonly TRUST_BASE_VERSION="${CUKUP_TRUST_BASE_VERSION:-}"
readonly TRUST_BASE_IMAGE="${CUKUP_TRUST_BASE_IMAGE:-}"
readonly TRUST_BASE_IMAGE_ID="${CUKUP_TRUST_BASE_IMAGE_ID:-}"
readonly TRUST_BASE_CONTAINER_ID="${CUKUP_TRUST_BASE_CONTAINER_ID:-}"
readonly TRUST_BASE_REVISION="${TRUST_BASE_VERSION%%-*}"
if [[ -n "$TRUST_BASE_VERSION$TRUST_BASE_IMAGE$TRUST_BASE_IMAGE_ID$TRUST_BASE_CONTAINER_ID" ]]; then
	if [[ ! "$TRUST_BASE_VERSION" =~ ^[0-9a-f]{40}-[A-Za-z0-9][A-Za-z0-9.-]*$ ||
		! "$TRUST_BASE_IMAGE" =~ ^[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9_][A-Za-z0-9_.-]*$ ||
		! "$TRUST_BASE_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ||
		! "$TRUST_BASE_CONTAINER_ID" =~ ^[0-9a-f]{64}$ ]]; then
		printf 'incomplete or invalid legacy rollback baseline\n' >&2
		exit 1
	fi
fi

readonly candidate="$CUKUP_REVISION"
readonly release_root="$CUKUP_RELEASE_ROOT"
readonly expected_image="ghcr.io/$CUKUP_IMAGE"
readonly remote_target="$CUKUP_SSH_USER@$CUKUP_DEPLOY_HOST"
readonly cutover="${CUKUP_HISTORY_CUTOVER:-}"
if [[ -n "$cutover" ]]; then
	[[ "${GITHUB_EVENT_NAME:-}" == workflow_dispatch && -z "$TRUST_BASE_VERSION" ]] || exit 1
	binding="$(jq -er --arg candidate "$candidate" '
		select(.candidate == $candidate and (.prior_revision | test("^[0-9a-f]{40}$"))
			and .prior_revision != $candidate and (.container_id | test("^[0-9a-f]{64}$"))
			and (.image_id | test("^sha256:[0-9a-f]{64}$"))
			and (.digest | test("^sha256:[0-9a-f]{64}$")) and (.run_id | test("^[1-9][0-9]*$")))
		| [.prior_revision, .container_id, .image_id, .digest, .run_id] | @tsv
	' <<< "$cutover" 2>/dev/null)" || { printf 'invalid history cutover binding\n' >&2; exit 1; }
	IFS=$'\t' read -r cutover_prior cutover_container cutover_image_id cutover_digest cutover_run_id <<< "$binding"
fi

[[ "$candidate" =~ ^[0-9a-f]{40}$ ]] || {
	printf 'revision must be a full lowercase commit SHA\n' >&2
	exit 1
}
[[ -d "$release_root/.git" ]] || {
	printf 'release checkout is unavailable\n' >&2
	exit 1
}
hostname_label='[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
for hostname in "$CUKUP_DEPLOY_HOST" "$CUKUP_API_HOSTNAME" "$CUKUP_DASHBOARD_HOSTNAME"; do
	if [[ ! "$hostname" =~ ^$hostname_label(\.$hostname_label)*$ || ${#hostname} -gt 253 ]]; then
		printf 'invalid deployment hostname\n' >&2
		exit 1
	fi
done
[[ "$CUKUP_SSH_USER" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ && "$CUKUP_API_HOSTNAME" != "$CUKUP_DASHBOARD_HOSTNAME" ]] || {
	printf 'invalid SSH user or duplicate public hostnames\n' >&2
	exit 1
}
project_slug='[a-z0-9]+(-[a-z0-9]+)*'
[[ "$CUKUP_WORK_PROJECTS" =~ ^$project_slug(,$project_slug)*$ ]] || {
	printf 'CUKUP_WORK_PROJECTS must contain comma-separated project slugs without spaces\n' >&2
	exit 1
}
IFS=, read -r -a work_projects <<< "$CUKUP_WORK_PROJECTS"
for slug in "${work_projects[@]}"; do
	if (( ${#slug} > 64 )); then
		printf 'CUKUP_WORK_PROJECTS slugs must not exceed 64 characters\n' >&2
		exit 1
	fi
done
[[ "$CUKUP_DATA_DIRECTORY" =~ ^/[A-Za-z0-9._/-]+$ ]] || {
	printf 'invalid data directory\n' >&2
	exit 1
}
[[ "$CUKUP_BACKUP_DIRECTORY" =~ ^/[A-Za-z0-9._/-]+$ ]] || {
	printf 'invalid backup directory\n' >&2
	exit 1
}
[[ -f "$CUKUP_SSH_KEY" ]] || {
	printf 'SSH key is unavailable\n' >&2
	exit 1
}
[[ "$(stat -c %a "$CUKUP_SSH_KEY")" == 600 ]] || {
	printf 'SSH key must have mode 0600\n' >&2
	exit 1
}

temp_dir="$(mktemp -d)"
chmod 0700 "$temp_dir"
rendered_config="$temp_dir/deploy.service.yml"
auth_config="$temp_dir/curl-auth.conf"
phase="startup"
prior_version=""
prior_container=""
prior_image=""
prior_runtime_hash=""
backup_base=""
mutation_started=0

cleanup() {
	rm -rf "$temp_dir"
}

summary() {
	local outcome="$1"
	if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
		# shellcheck disable=SC2016 # Markdown backticks are literal.
		printf -- '- `%s` `%s` for `%s` at phase `%s`.\n' "$mode" "$outcome" "$candidate" "$phase" \
			>> "$GITHUB_STEP_SUMMARY"
	fi
}

remote() {
	ssh \
		-i "$CUKUP_SSH_KEY" \
		-o IdentitiesOnly=yes \
		-o BatchMode=yes \
		-o ForwardAgent=no \
		-o StrictHostKeyChecking=yes \
		-o ConnectTimeout=15 \
		"$remote_target" "$@"
}

run_kamal() {
	local version="$1"
	shift
	(
		cd "$release_root"
		VERSION="$version" kamal "$@" -c "$rendered_config"
	)
}

running_info() {
	# shellcheck disable=SC2016 # This script is evaluated by the remote shell.
	remote 'set -eu
ids=$(docker ps -q --filter label=service=cukup-service)
test "$(printf "%s\n" "$ids" | sed "/^$/d" | wc -l | tr -d " ")" = 1
id=$ids
docker inspect "$id" | jq -r ".[0] | [.Id, .Name, .Config.Image] | @tsv"'
}

verify_cutover_baseline() {
	local info
	info="$(running_info)" || return 1
	[[ "$info" == "$cutover_container"$'\t'"/cukup-service-web-$cutover_prior"$'\t'"$expected_image:$cutover_prior" ]] || return 1
	[[ "$(remote "docker inspect '$cutover_container' --format '{{.Image}}'")" == "$cutover_image_id" ]]
}

running_version() {
	local info id name version
	info="$(running_info 2>/dev/null)" || return 1
	IFS=$'\t' read -r id name _ <<< "$info"
	name="${name#/}"
	version="${name#cukup-service-web-}"
	[[ "$name" == "cukup-service-web-$version" ]] || return 1
	[[ "$version" =~ ^[0-9a-f]{40}$ || ( -n "$TRUST_BASE_VERSION" && "$version" == "$TRUST_BASE_VERSION" ) ]] || return 1
	printf '%s\n' "$version"
}

verify_live_runtime() {
	local container="$1" version="$2" check_mode=""
	[[ "$container" =~ ^[0-9a-f]{64}$ ]] || return 1
	if [[ "$version" == "$TRUST_BASE_VERSION" ]]; then
		check_mode="--legacy-trust-baseline"
	fi
	remote "docker exec -i '$container' bun run - $check_mode" < "$release_root/scripts/check-service-runtime.ts"
}

runtime_hash() {
	local container="$1" ignore_setting="${2:-}"
	[[ "$container" =~ ^[0-9a-f]{64}$ ]] || return 1
	remote "set -o pipefail; docker inspect '$container' | jq -S -c --arg ignore '$ignore_setting' '.[0] | {
Env:(.Config.Env | map(select((startswith(\"KAMAL_CONTAINER_NAME=\") or startswith(\"KAMAL_VERSION=\") or (\$ignore != \"\" and startswith(\$ignore + \"=\"))) | not)) | sort),
ReadonlyRootfs:.HostConfig.ReadonlyRootfs,
NanoCpus:.HostConfig.NanoCpus,
Memory:.HostConfig.Memory,
MemorySwap:.HostConfig.MemorySwap,
PidsLimit:.HostConfig.PidsLimit,
Binds:(.HostConfig.Binds | sort)
}' | sha256sum | cut -d' ' -f1"
}

verify_runtime_configuration() {
	local container="$1" name expected_hash actual_hash matches=1
	shift
	[[ "$container" =~ ^[0-9a-f]{64}$ ]] || return 1
	for name in "$@"; do
		expected_hash="$(printf '%s' "${!name}" | sha256sum | cut -d' ' -f1)"
		if ! actual_hash="$(remote "set -o pipefail; docker inspect '$container' | jq -r --arg name '$name' '.[0].Config.Env | map(select(startswith(\$name + \"=\"))) | if length == 1 then .[0][(\$name | length) + 1:] else error(\"missing or duplicate environment entry\") end' | tr -d '\\n' | sha256sum | cut -d' ' -f1" 2>/dev/null)"; then
			printf 'runtime setting is unavailable for comparison: %s\n' "$name" >&2
			return 1
		fi
		if [[ "$actual_hash" != "$expected_hash" ]]; then
			printf 'runtime setting does not match protected environment: %s\n' "$name" >&2
			matches=0
		fi
	done
	(( matches ))
}

verify_database() {
	local output
	output="$(remote "sudo -n sqlite3 -readonly '$CUKUP_DATA_DIRECTORY/cukup.sqlite' 'PRAGMA user_version; PRAGMA integrity_check;'" 2>/dev/null)" || return 1
	[[ "$output" == $'4\nok' ]]
}

verify_preservation() {
	local output
	[[ "$backup_base" =~ ^[0-9A-Za-z-]+$ ]] || return 1
	output="$(remote "sudo -n sqlite3 -readonly '$CUKUP_DATA_DIRECTORY/cukup.sqlite' \"ATTACH DATABASE '$CUKUP_BACKUP_DIRECTORY/$backup_base.sqlite' AS pre;
PRAGMA main.user_version;
PRAGMA main.integrity_check;
SELECT EXISTS(SELECT * FROM pre.auth_tokens EXCEPT SELECT * FROM main.auth_tokens);
SELECT EXISTS(SELECT * FROM pre.source_owners EXCEPT SELECT * FROM main.source_owners);
SELECT EXISTS(SELECT * FROM pre.events EXCEPT SELECT * FROM main.events);
SELECT EXISTS(SELECT * FROM pre.target_overrides EXCEPT SELECT * FROM main.target_overrides);\"" 2>/dev/null)" || return 1
	[[ "$output" == $'4\nok\n0\n0\n0\n0' ]]
}

verify_public_once() {
	local body headers code location
	body="$temp_dir/public-body"
	headers="$temp_dir/public-headers"

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--output "$body" --write-out '%{http_code}' "https://$CUKUP_API_HOSTNAME/healthz")" || return 1
	[[ "$code" == 200 ]] || return 1
	jq -e '. == {"ok":true}' "$body" >/dev/null 2>&1 || return 1

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--output "$body" --write-out '%{http_code}' "https://$CUKUP_DASHBOARD_HOSTNAME/up")" || return 1
	[[ "$code" == 200 ]] || return 1
	jq -e '. == {"ok":true}' "$body" >/dev/null 2>&1 || return 1

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--output "$body" --write-out '%{http_code}' "https://$CUKUP_DASHBOARD_HOSTNAME/")" || return 1
	[[ "$code" == 200 ]] || return 1
	grep -Fq 'href="/auth/github"' "$body" || return 1

	for asset in dashboard.css dashboard.js favicon.svg; do
		code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
			--output "$body" --write-out '%{http_code}' \
			"https://$CUKUP_DASHBOARD_HOSTNAME/assets/$asset")" || return 1
		[[ "$code" == 200 && -s "$body" ]] || return 1
	done

	code="$(curl --silent --show-error --connect-timeout 10 --max-time 20 \
		--dump-header "$headers" --output "$body" --write-out '%{http_code}' \
		"https://$CUKUP_DASHBOARD_HOSTNAME/auth/github")" || return 1
	[[ "$code" == 303 ]] || return 1
	location="$(sed -n 's/^[Ll]ocation:[[:space:]]*//p' "$headers" | tr -d '\r' | tail -n1)"
	[[ "$location" == https://github.com/login/oauth/authorize\?* ]] || return 1
	grep -Eiq '^set-cookie:[[:space:]]*__Host-cukup_oauth=' "$headers" || return 1
}

verify_authenticated_api_once() {
	local body code endpoint
	[[ -n "${CUKUP_API_TOKEN:-}" ]] || return 0
	body="$temp_dir/api-response.json"
	for endpoint in capabilities time summary; do
		code="$(curl --config "$auth_config" --silent --show-error --connect-timeout 10 --max-time 20 \
			--output "$body" --write-out '%{http_code}' \
			"https://$CUKUP_API_HOSTNAME/v1/$endpoint")" || return 1
		[[ "$code" == 200 ]] || return 1
		case "$endpoint" in
			capabilities)
				jq -e '.schema_version == 1 and .accepted_event_schema_versions == [1, 2] and .preferred_new_event_schema_version == 2' "$body" >/dev/null
				;;
			time)
				jq -e '.server_time | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T")' "$body" >/dev/null
				;;
			summary)
				jq -e 'type == "object" and .schema_version == 1 and (.daily | type == "object") and (.weekly | type == "object")' "$body" >/dev/null
				;;
		esac
	done
}

verify_service() {
	local _
	for _ in {1..12}; do
		if verify_public_once && verify_authenticated_api_once; then
			return 0
		fi
		sleep 5
	done
	return 1
}

verify_remote_image() {
	local image_json
	image_json="$(remote "docker image inspect '${1:-$expected_image:$candidate}'" 2>/dev/null)" || return 1
	jq -e --arg sha "$candidate" --arg service "$EXPECTED_SERVICE" --arg source "$EXPECTED_SOURCE" \
		--arg digest "${cutover_digest:+$expected_image@$cutover_digest}" '
		length == 1 and
		.[0].Os == "linux" and .[0].Architecture == "amd64" and
		.[0].Config.Labels.service == $service and
		.[0].Config.Labels["org.opencontainers.image.source"] == $source and
		.[0].Config.Labels["org.opencontainers.image.revision"] == $sha and
		($digest == "" or any(.[0].RepoDigests[]; . == $digest))
	' <<< "$image_json" >/dev/null
}

verify_source_authorization() {
	local main_tip commit_json runs_json
	main_tip="$(gh api "repos/$EXPECTED_REPOSITORY/git/ref/heads/main" --jq .object.sha)"
	[[ "$main_tip" =~ ^[0-9a-f]{40}$ ]] || return 1
	git -C "$release_root" merge-base --is-ancestor "$candidate" "$main_tip" || return 1
	if [[ -n "$cutover" ]]; then
		[[ "$candidate" == "$main_tip" && "$(git -C "$release_root" rev-parse HEAD)" == "$candidate" ]] || return 1
	fi

	for revision in "$candidate" "$main_tip"; do
		commit_json="$(gh api "repos/$EXPECTED_REPOSITORY/commits/$revision")" || return 1
		jq -e --arg sha "$revision" '
			.sha == $sha and .commit.verification.verified == true and .commit.verification.reason == "valid"
		' <<< "$commit_json" >/dev/null || return 1
	done

	if [[ -n "$cutover" ]]; then
		runs_json="$(gh api "repos/$EXPECTED_REPOSITORY/actions/runs/$cutover_run_id")" || return 1
		jq -e --arg sha "$candidate" --arg id "$cutover_run_id" '
			(.id | tostring) == $id and .name == "Publish service image" and
			.path == ".github/workflows/publish-service.yml" and .event == "workflow_dispatch" and
			.head_branch == "main" and .head_sha == $sha and .status == "completed" and .conclusion == "success"
		' <<< "$runs_json" >/dev/null || return 1
		return 0
	fi

	# The API's completed filter can omit successful reruns. Check status locally.
	runs_json="$(gh api -X GET "repos/$EXPECTED_REPOSITORY/actions/workflows/publish-service.yml/runs" \
		-f branch=main -f head_sha="$candidate" -f per_page=100)" || return 1
	jq -e --arg sha "$candidate" '
		any(.workflow_runs[];
			.name == "Publish service image" and
			.path == ".github/workflows/publish-service.yml" and
			.event == "push" and .head_branch == "main" and .head_sha == $sha and
			.status == "completed" and .conclusion == "success")
	' <<< "$runs_json" >/dev/null
}

verify_local_image() {
	local image_json
	docker pull --quiet --platform linux/amd64 "$expected_image:$candidate" >/dev/null
	image_json="$(docker image inspect "$expected_image:$candidate")"
	jq -e --arg sha "$candidate" --arg service "$EXPECTED_SERVICE" --arg source "$EXPECTED_SOURCE" --arg image "$expected_image" \
		--arg digest "${cutover_digest:+$expected_image@$cutover_digest}" '
		length == 1 and .[0].Os == "linux" and .[0].Architecture == "amd64" and
		.[0].Config.Labels.service == $service and
		.[0].Config.Labels["org.opencontainers.image.source"] == $source and
		.[0].Config.Labels["org.opencontainers.image.revision"] == $sha and
		any(.[0].RepoDigests[]; if $digest == "" then startswith($image + "@sha256:") else . == $digest end)
	' <<< "$image_json" >/dev/null
	docker run --rm --read-only -i --entrypoint bun "$expected_image:$candidate" run - \
		< "$release_root/scripts/check-service-runtime.ts"
}

render_config() {
	cp "$release_root/config/deploy.service.yml" "$rendered_config"
	cat >> "$rendered_config" <<'YAML'

# GitHub Actions operator controls. Retain existing Cukup containers while the
# canary proves rollback safety, and use only the dedicated deployment key.
retain_containers: 1000
ssh:
  user: <%= ENV.fetch("CUKUP_SSH_USER") %>
  keys_only: true
  keys:
    - <%= ENV.fetch("CUKUP_SSH_KEY") %>
YAML
	chmod 0600 "$rendered_config"
	run_kamal "$candidate" config >/dev/null
}

verify_no_deploy_lock() {
	local output
	output="$(run_kamal "$candidate" lock status 2>&1)" || return 1
	grep -Fq 'There is no deploy lock' <<< "$output"
}

take_predeploy_backup() {
	remote "set -euo pipefail
before=\$(sudo -n find '$CUKUP_BACKUP_DIRECTORY' -maxdepth 1 -type f -name '*.sqlite' -printf '%f\\n' | sort | tail -n1)
sudo -n systemctl start cukup-backup.service
test \"\$(sudo -n systemctl show cukup-backup.service -p Result --value)\" = success
test \"\$(sudo -n systemctl show cukup-backup.service -p ExecMainStatus --value)\" = 0
after=\$(sudo -n find '$CUKUP_BACKUP_DIRECTORY' -maxdepth 1 -type f -name '*.sqlite' -printf '%f\\n' | sort | tail -n1)
test -n \"\$after\"
test \"\$after\" != \"\$before\"
base=\${after%.sqlite}
case \"\$base\" in *[!0-9A-Za-z-]*) exit 1;; esac
sudo -n test -f '$CUKUP_BACKUP_DIRECTORY/'\"\$base.json\"
sudo -n jq -e --arg base \"\$base\" '.integrity_check == \"ok\" and .sqlite_user_version == 4 and .database_file == (\$base + \".sqlite\")' '$CUKUP_BACKUP_DIRECTORY/'\"\$base.json\" >/dev/null
printf '%s\\n' \"\$base\"" 2>/dev/null
}

verify_independent_backup() {
	local sqlite="$temp_dir/$backup_base.sqlite"
	local metadata="$temp_dir/$backup_base.json"
	[[ "$backup_base" =~ ^[0-9A-Za-z-]+$ ]] || return 1
	remote "sudo -n cat '$CUKUP_BACKUP_DIRECTORY/$backup_base.sqlite'" > "$sqlite"
	remote "sudo -n cat '$CUKUP_BACKUP_DIRECTORY/$backup_base.json'" > "$metadata"
	chmod 0600 "$sqlite" "$metadata"
	bun run "$release_root/service/database-ops.ts" verify "$sqlite" "$metadata" \
		> "$temp_dir/backup-verification.json"
	jq -e --arg base "$backup_base" '
		.integrity_check == "ok" and .sqlite_user_version == 4 and .database_file == ($base + ".sqlite")
	' "$temp_dir/backup-verification.json" >/dev/null
}

rollback_if_needed() {
	local current rollback_ok=1 info id name
	[[ -n "$prior_version" ]] || return 1
	current="$(running_version 2>/dev/null || true)"
	if [[ "$current" != "$prior_version" ]]; then
		if [[ -n "$cutover" ]]; then
			[[ "$(remote "docker container inspect 'cukup-service-web-$cutover_prior' --format '{{.Id}} {{.Image}}'" 2>/dev/null)" == "$cutover_container $cutover_image_id" ]] || return 1
		fi
		if [[ -n "$cutover" || "$prior_version" == "$TRUST_BASE_VERSION" ]]; then
			# Restore the exact retained container without recreating it.
			remote "docker stop 'cukup-service-web-$candidate'" >/dev/null 2>&1 || true
			run_kamal "$prior_version" app start >/dev/null 2>&1 || rollback_ok=0
		else
			# Kamal recreates the prior release using the supplied environment.
			(
				if [[ -n "$prior_work_projects_entry" ]]; then
					export CUKUP_WORK_PROJECTS="${prior_work_projects_entry#CUKUP_WORK_PROJECTS=}"
				else
					unset CUKUP_WORK_PROJECTS
				fi
				run_kamal "$prior_version" rollback "$prior_version"
			) >/dev/null 2>&1 || rollback_ok=0
		fi
	fi
	[[ "$(running_version 2>/dev/null || true)" == "$prior_version" ]] || rollback_ok=0
	info="$(running_info 2>/dev/null || true)"
	IFS=$'\t' read -r id name _ <<< "$info"
	if [[ "$prior_version" == "$TRUST_BASE_VERSION" ]]; then
		[[ "$id" == "$prior_container" ]] || rollback_ok=0
		[[ "$(remote "docker inspect '$id' --format '{{.Image}}'" 2>/dev/null)" == "$TRUST_BASE_IMAGE_ID" ]] || rollback_ok=0
	fi
	if [[ -n "$cutover" ]]; then
		verify_cutover_baseline >/dev/null 2>&1 || rollback_ok=0
	fi
	[[ -n "$id" && "$(runtime_hash "$id" 2>/dev/null || true)" == "$prior_runtime_hash" ]] || rollback_ok=0
	verify_live_runtime "$id" "$prior_version" >/dev/null 2>&1 || rollback_ok=0
	verify_service >/dev/null 2>&1 || rollback_ok=0
	verify_database >/dev/null 2>&1 || rollback_ok=0
	verify_preservation >/dev/null 2>&1 || rollback_ok=0
	(( rollback_ok ))
}

on_error() {
	local status=$?
	trap - ERR
	set +e
	printf 'deployment failed at phase: %s\n' "$phase" >&2
	if (( mutation_started )); then
		phase="rollback"
		if rollback_if_needed; then
			printf 'rollback verified: restored %s\n' "$prior_version" >&2
			summary "failed-and-rolled-back"
		else
			printf 'rollback could not be verified\n' >&2
			summary "failed-rollback-unverified"
		fi
	else
		summary "failed-before-deploy"
	fi
	exit "$status"
}

trap cleanup EXIT
trap on_error ERR

if [[ -n "${CUKUP_API_TOKEN:-}" ]]; then
	[[ "$CUKUP_API_TOKEN" =~ ^cukup_v1_[A-Za-z0-9_-]{43}$ ]] || {
		printf 'acceptance token has an invalid format\n' >&2
		exit 1
	}
	printf 'header = "Authorization: Bearer %s"\n' "$CUKUP_API_TOKEN" > "$auth_config"
	chmod 0600 "$auth_config"
fi

phase="source-authorization"
verify_source_authorization

phase="image-verification"
verify_local_image

phase="operator-config"
render_config

phase="remote-lock"
verify_no_deploy_lock

phase="current-service"
info="$(running_info)"
IFS=$'\t' read -r prior_container prior_name prior_image <<< "$info"
prior_name="${prior_name#/}"
prior_version="${prior_name#cukup-service-web-}"
[[ "$prior_container" =~ ^[0-9a-f]{64}$ ]]
[[ "$prior_name" == "cukup-service-web-$prior_version" ]]
prior_revision="$prior_version"
if [[ -n "$cutover" ]]; then
	[[ "$prior_container" == "$cutover_container" && "$prior_version" == "$cutover_prior" ]]
	verify_cutover_baseline
elif [[ -n "$TRUST_BASE_VERSION" && "$prior_version" == "$TRUST_BASE_VERSION" ]]; then
	[[ "$prior_image" == "$TRUST_BASE_IMAGE" ]]
	[[ "$prior_container" == "$TRUST_BASE_CONTAINER_ID" ]]
	[[ "$(remote "docker inspect '$prior_container' --format '{{.Image}}'")" == "$TRUST_BASE_IMAGE_ID" ]]
	prior_revision="$TRUST_BASE_REVISION"
else
	[[ "$prior_version" =~ ^[0-9a-f]{40}$ ]]
	[[ "$prior_image" == "$expected_image:$prior_version" ]]
fi
if [[ -z "$cutover" ]]; then
	git -C "$release_root" merge-base --is-ancestor "$prior_revision" "$candidate"
	git -C "$release_root" show "$prior_revision:service/store.ts" | grep -Eq '^const DATABASE_VERSION = 4$'
fi
prior_runtime_hash="$(runtime_hash "$prior_container")"
[[ "$prior_runtime_hash" =~ ^[0-9a-f]{64}$ ]]
phase="runtime-configuration"
verify_runtime_configuration "$prior_container" \
	CUKUP_API_HOSTNAME CUKUP_DASHBOARD_HOSTNAME CUKUP_OIDC_ALLOWED_USER_ID CUKUP_FLEET_HOSTNAMES \
	CUKUP_GITHUB_OAUTH_CLIENT_ID CUKUP_GITHUB_OAUTH_CLIENT_SECRET CUKUP_GITHUB_ALLOWED_USER_ID CUKUP_DASHBOARD_SESSION_KEYS
if [[ "$prior_version" == "$candidate" ]]; then
	verify_runtime_configuration "$prior_container" CUKUP_WORK_PROJECTS
fi
remote "set -o pipefail; docker inspect '$prior_container' | jq -e --arg source '$CUKUP_DATA_DIRECTORY' '.[0].Mounts | map(select(.Destination == \"/var/lib/cukup\")) | length == 1 and .[0].Type == \"bind\" and .[0].Source == \$source'" >/dev/null
phase="current-service"
verify_live_runtime "$prior_container" "$prior_version"
verify_database
verify_service

if [[ "$mode" == "preflight" ]]; then
	phase="complete"
	summary "success-no-mutation"
	exit 0
fi

if [[ "$prior_version" == "$candidate" ]]; then
	phase="already-current"
	verify_remote_image
	summary "success-no-mutation"
	exit 0
fi

phase="predeploy-backup"
# The prior release may not have this setting. Keep the full hash for rollback.
prior_preserved_runtime_hash="$(runtime_hash "$prior_container" CUKUP_WORK_PROJECTS)"
[[ "$prior_preserved_runtime_hash" =~ ^[0-9a-f]{64}$ ]]
prior_work_projects_entry="$(remote "set -o pipefail; docker inspect '$prior_container' | jq -r --arg name 'CUKUP_WORK_PROJECTS' '.[0].Config.Env | map(select(startswith(\$name + \"=\"))) | if length <= 1 then .[] else error(\"duplicate Work project setting\") end'")"
backup_base="$(take_predeploy_backup)"
verify_independent_backup
verify_preservation

phase="final-authorization"
if [[ -n "$cutover" ]]; then
	# Boot the verified local tag without pulling it again during the cutover.
	run_kamal "$candidate" build pull
	verify_remote_image
fi
verify_source_authorization
if [[ -n "$cutover" ]]; then
	verify_cutover_baseline
	[[ "$(runtime_hash "$prior_container")" == "$prior_runtime_hash" ]]
fi

phase="deploy"
mutation_started=1
if [[ -n "$cutover" ]]; then
	run_kamal "$candidate" app boot --version "$candidate"
else
	run_kamal "$candidate" redeploy --skip-push
fi

phase="post-deploy"
[[ "$(running_version)" == "$candidate" ]]
verify_remote_image
post_info="$(running_info)"
IFS=$'\t' read -r post_container post_name post_image <<< "$post_info"
[[ "${post_name#/}" == "cukup-service-web-$candidate" ]]
[[ "$post_image" == "$expected_image:$candidate" ]]
if [[ -n "$cutover" ]]; then
	post_image_id="$(remote "docker inspect '$post_container' --format '{{.Image}}'")"
	[[ "$post_image_id" =~ ^sha256:[0-9a-f]{64}$ ]]
	verify_remote_image "$post_image_id"
fi
[[ "$(runtime_hash "$post_container" CUKUP_WORK_PROJECTS)" == "$prior_preserved_runtime_hash" ]]
verify_runtime_configuration "$post_container" CUKUP_WORK_PROJECTS
remote "docker container inspect '$prior_container'" >/dev/null
remote "docker image inspect '$prior_image'" >/dev/null
verify_live_runtime "$post_container" "$candidate"
verify_service
verify_database
verify_preservation

mutation_started=0
phase="complete"
summary "success"
