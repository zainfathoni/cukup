{
  "name": "cukup",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "test": "bun test plugin service",
    "typecheck": "tsc --noEmit",
    "build:plugin": "bun build plugin/index.ts --target=bun --external @ampcode/plugin --outfile dist/plugin.js",
    "build:service": "bun build service/index.ts service/database-ops.ts service/token-admin.ts --target=bun --outdir dist/service",
    "build": "bun run build:plugin && bun run build:service",
    "start:service": "bun run service/index.ts",
    "service:db": "bun run service/database-ops.ts",
    "service:token": "bun run service/token-admin.ts",
    "check": "bun run test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "jose": "6.1.0"
  },
  "devDependencies": {
    "@ampcode/plugin": "0.0.0-20260830001921-g9741aa9",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
