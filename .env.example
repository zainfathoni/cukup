# Docker service settings. Replace all placeholders in a private copy.
CUKUP_API_HOSTNAME=api.cukup.example.com
CUKUP_DASHBOARD_HOSTNAME=cukup.example.com
CUKUP_GITHUB_OAUTH_CLIENT_ID=replace-with-your-client-id
CUKUP_GITHUB_OAUTH_CLIENT_SECRET=replace-with-your-client-secret
CUKUP_GITHUB_ALLOWED_USER_ID=replace-with-your-numeric-github-id
CUKUP_DASHBOARD_SESSION_KEYS=replace-with-your-32-byte-base64url-key
CUKUP_OIDC_ALLOWED_USER_ID=replace-with-your-amp-user-id

# Optional reporting settings. Use your Amp project slugs and local OS hostnames.
# CUKUP_WORK_PROJECTS=client-portal,documentation
# CUKUP_NEW_TURN_EVENT_SCHEMA_VERSION=2
# CUKUP_FLEET_HOSTNAMES=laptop.example.com,desktop.example.com

# Plugin settings. Set these in Amp's environment, not in the Docker env file.
# CUKUP_SERVICE_URL=https://api.cukup.example.com
# CUKUP_TOKEN_FILE=/absolute/path/to/token
