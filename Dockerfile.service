FROM oven/bun:1.3.10 AS build

WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile
COPY service ./service
# Only the approved explainer files and the link-preview image ship. The service never synthesizes or renders media.
COPY media/motion-explainer/cukup-explainer.mp4 media/motion-explainer/poster.png media/motion-explainer/captions.en.vtt media/motion-explainer/transcript.md ./media/motion-explainer/
COPY media/og-image/og-image.png ./media/og-image/
RUN bun run build:service

# Pin the fixed amd64 executable without changing the runtime filesystem or builder.
FROM oven/bun:1.4.4-slim@sha256:13b43f8bb2c63f5d89c56205c4279b85620363296a00ada33ff7ad568f3688e7 AS fixed-bun

FROM oven/bun:1.3.10-slim AS runtime

COPY --from=fixed-bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
RUN mkdir -p /var/lib/cukup && chown bun:bun /var/lib/cukup
COPY --from=build --chown=bun:bun /app/dist/service ./
COPY LICENSE ./licenses/Cukup.txt
COPY --from=build /app/node_modules/jose/LICENSE.md ./licenses/jose.txt

USER bun
ENV CUKUP_DATABASE_PATH=/var/lib/cukup/cukup.sqlite \
    CUKUP_HOST=0.0.0.0 \
    CUKUP_BEHIND_TLS_PROXY=1 \
    CUKUP_NEW_TURN_EVENT_SCHEMA_VERSION=1 \
    PORT=3000
VOLUME ["/var/lib/cukup"]
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD ["bun", "-e", "const r=await fetch('http://127.0.0.1:3000/up');process.exit(r.ok?0:1)"]

ENTRYPOINT ["bun", "/app/index.js"]
