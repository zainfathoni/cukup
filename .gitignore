# Keep the repository surface intentional: ignore files by default, then allow
# only the file types and naming conventions used by the tracked project.
*
!*/

# Root project metadata.
!/.dockerignore
!/.gitignore
!/*.md
!/Dockerfile.*
!/LICENSE
!/bun.lock
!/package.json
!/tsconfig.json

# Tracked file families by project area, derived from `git ls-files`.
!/.agents/*
!/.amp/*.yaml
!/.github/**/*.yml
!/config/*.yml
!/docs/**/*.md
!/docs/**/*.png
!/experimental/**/*.json
!/experimental/**/*.ts
!/plugin/**/*.md
!/plugin/**/*.ts
!/scripts/*.sh
!/scripts/deploy-service
!/service/**/*.css
!/service/**/*.ts
!/media/motion-explainer/**/*.css
!/media/motion-explainer/**/*.html
!/media/motion-explainer/**/*.js
!/media/motion-explainer/**/*.m4a
!/media/motion-explainer/**/*.md
!/media/motion-explainer/**/*.mp4
!/media/motion-explainer/**/*.png
!/media/motion-explainer/**/*.py
!/media/motion-explainer/**/*.ts
!/media/motion-explainer/**/*.vtt

# Generated output and portal metadata stay ignored explicitly for clarity.
node_modules/
dist/
.amp/portals/
.amp/portals/**
/media/motion-explainer/frames/
/media/motion-explainer/out/
