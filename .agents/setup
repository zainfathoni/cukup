#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '[setup] %s %s\n' "$(date -u +%H:%M:%S)" "$*"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bun_version="$(sed -n 's/.*"packageManager": "bun@\([^"]*\)".*/\1/p' package.json)"
if [[ -z "$bun_version" ]]; then
  printf '[setup] package.json must pin packageManager to bun@<version>\n' >&2
  exit 1
fi

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

if [[ "$(bun --version 2>/dev/null || true)" != "$bun_version" ]]; then
  missing_packages=()
  command -v curl >/dev/null 2>&1 || missing_packages+=(curl)
  command -v unzip >/dev/null 2>&1 || missing_packages+=(unzip)

  if (( ${#missing_packages[@]} )); then
    log "installing system prerequisites: ${missing_packages[*]}"
    sudo apt-get update
    sudo apt-get install -y "${missing_packages[@]}"
  fi

  log "installing Bun $bun_version"
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v$bun_version"
  hash -r
fi

profile_marker="# cukup Bun toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  log "making Bun available to login shells"
  cat >> "$HOME/.bash_profile" <<'EOF'

# cukup Bun toolchain
export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in
  *":$BUN_INSTALL/bin:"*) ;;
  *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
esac
EOF
fi

log "installing locked dependencies"
bun install --frozen-lockfile
log "ready"
